<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:EcoAppMobile"
             x:Class="EcoAppMobile.App">

    <Application.Resources>
        <ResourceDictionary>

            <!-- ЦВЕТОВАЯ ПАЛИТРА -->
            <Color x:Key="BackgroundDark">#0D0D1A</Color>
            <Color x:Key="SurfaceDark">#1A1A2E</Color>
            <Color x:Key="SurfaceElevated">#252540</Color>
            <Color x:Key="PrimaryPurple">#7C3AED</Color>
            <Color x:Key="PrimaryPurpleLight">#A78BFA</Color>
            <Color x:Key="AccentGreen">#10B981</Color>
            <Color x:Key="AccentGreenDark">#059669</Color>
            <Color x:Key="AccentBlue">#3B82F6</Color>
            <Color x:Key="AccentRed">#EF4444</Color>
            <Color x:Key="AccentOrange">#F59E0B</Color>
            <Color x:Key="TextPrimary">#FFFFFF</Color>
            <Color x:Key="TextSecondary">#A1A1AA</Color>
            <Color x:Key="TextMuted">#71717A</Color>
            <Color x:Key="BorderColor">#27273A</Color>

            <!-- ГРАДИЕНТЫ -->
            <LinearGradientBrush x:Key="PurpleGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#7C3AED"/>
                <GradientStop Offset="1" Color="#4C1D95"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="GreenGradient" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Offset="0" Color="#10B981"/>
                <GradientStop Offset="1" Color="#059669"/>
            </LinearGradientBrush>

            <LinearGradientBrush x:Key="CardGradient" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#1E1E3A"/>
                <GradientStop Offset="1" Color="#151528"/>
            </LinearGradientBrush>

            <!-- СТИЛИ КНОПОК -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{StaticResource PurpleGradient}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="BorderColor" Value="{StaticResource PrimaryPurple}"/>
                <Setter Property="BorderWidth" Value="2"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryPurpleLight}"/>
                <Setter Property="CornerRadius" Value="16"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="FontSize" Value="16"/>
            </Style>

            <Style x:Key="DangerButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource AccentRed}"/>
                <Setter Property="TextColor" Value="White"/>
                <Setter Property="CornerRadius" Value="12"/>
                <Setter Property="HeightRequest" Value="48"/>
                <Setter Property="FontAttributes" Value="Bold"/>
            </Style>

            <!-- СТИЛИ ФРЕЙМОВ/КАРТОЧЕК -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardGradient}"/>
                <Setter Property="Stroke" Value="{StaticResource BorderColor}"/>
                <Setter Property="StrokeThickness" Value="1"/>
                <Setter Property="Padding" Value="20"/>
                <Setter Property="Margin" Value="16,8"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 20"/>
            </Style>

            <!-- СТИЛИ ВВОДА -->
            <Style x:Key="InputContainerStyle" TargetType="Border">
                <Setter Property="BackgroundColor" Value="{StaticResource SurfaceElevated}"/>
                <Setter Property="StrokeShape" Value="RoundRectangle 12"/>
                <Setter Property="HeightRequest" Value="52"/>
                <Setter Property="MinimumHeightRequest" Value="48"/>
                <Setter Property="Padding" Value="16,0"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>