<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="EcoAppMobile.TasksPage"
    Title="Задания"
    BackgroundColor="{StaticResource BackgroundDark}">

    <Grid RowDefinitions="Auto,*">

        <!-- ШАПКА С БАЛЛАМИ -->
        <Border 
            Grid.Row="0"
            Background="{StaticResource PurpleGradient}"
            StrokeShape="RoundRectangle 0,0,24,24"
            Padding="20"
            Margin="0,0,0,16"
            HeightRequest="80">

            <Grid ColumnDefinitions="Auto,*,Auto">
                <Label 
                    Grid.Column="0"
                    Text="🌿" 
                    FontSize="32"
                    VerticalOptions="Center"/>

                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Margin="12,0">
                    <Label 
                        Text="Мои баллы" 
                        FontSize="14"
                        TextColor="White"/>
                    <Label 
                        x:Name="UserPointsLabel"
                        Text="0" 
                        FontSize="24"
                        FontAttributes="Bold"
                        TextColor="White"/>
                </VerticalStackLayout>

              
            </Grid>
        </Border>

        <RefreshView 
            Grid.Row="1"
            x:Name="TasksRefreshView"
            RefreshColor="{StaticResource AccentGreen}"
            Refreshing="OnRefreshing">

            <CollectionView 
                x:Name="TasksList"
                Margin="16,0,16,16">

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border 
                            Background="{StaticResource CardGradient}"
                            Stroke="{StaticResource BorderColor}"
                            StrokeThickness="1"
                            Padding="20"
                            Margin="0,8"
                            StrokeShape="RoundRectangle 20">

                            <VerticalStackLayout Spacing="12">

                                <!-- Заголовок и иконка -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="4">
                                        <Label 
                                            Text="{Binding Title}" 
                                            FontSize="18" 
                                            FontAttributes="Bold"
                                            TextColor="White"/>

                                        <Label 
                                            Text="{Binding Category}" 
                                            FontSize="12"
                                            TextColor="{StaticResource PrimaryPurpleLight}"
                                            FontAttributes="Bold"/>
                                    </VerticalStackLayout>

                                    <Border 
                                        Grid.Column="1"
                                        BackgroundColor="{StaticResource SurfaceElevated}"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="8"
                                        IsVisible="{Binding RequiresPhoto}">
                                        <Label Text="📷" FontSize="20"/>
                                    </Border>
                                </Grid>

                                <Label 
                                    Text="{Binding Description}" 
                                    FontSize="14" 
                                    TextColor="{StaticResource TextSecondary}"
                                    MaxLines="2"
                                    LineBreakMode="TailTruncation"/>

                                <!-- Баллы -->
                                <Border 
                                    BackgroundColor="#10B98120"
                                    Stroke="{StaticResource AccentGreen}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 8"
                                    Padding="8,4"
                                    HorizontalOptions="Start">
                                    <Label 
                                        Text="{Binding Points, StringFormat='⭐ {0} баллов'}" 
                                        TextColor="{StaticResource AccentGreen}"
                                        FontAttributes="Bold"
                                        FontSize="14"/>
                                </Border>

                                <!-- КНОПКИ СТАТУСОВ -->
                                <Button 
                                    Text="Выполнить задание"
                                    Background="{StaticResource PurpleGradient}"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    FontAttributes="Bold"
                                    Clicked="OnCompleteClicked"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding ShowExecuteButton}"/>

                                <HorizontalStackLayout 
                                    Spacing="12"
                                    IsVisible="{Binding ShowPhotoButtons}"
                                    HorizontalOptions="Center">

                                    <Button 
                                        Text="📷 Камера"
                                        BackgroundColor="{StaticResource AccentBlue}"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="44"
                                        Clicked="OnTakePhotoClicked"
                                        CommandParameter="{Binding .}"/>

                                    <Button 
                                        Text="🖼️ Галерея"
                                        BackgroundColor="{StaticResource PrimaryPurple}"
                                        TextColor="White"
                                        CornerRadius="12"
                                        HeightRequest="44"
                                        Clicked="OnPickPhotoClicked"
                                        CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>

                                <Image 
                                    Source="{Binding PreviewImageSource}"
                                    HeightRequest="160" 
                                    Aspect="AspectFill"
                                    IsVisible="{Binding HasPreviewImage}"
                                    Margin="0,4"/>
                                <!-- ВЫПОЛНЕНО -->
                                <VerticalStackLayout 
                                    IsVisible="{Binding ShowApprovedIcon}"
                                    HorizontalOptions="Center"
                                    Spacing="8"
                                    Margin="0,12">
                                <Label 
                                    Text="Выполнено!" 
                                    TextColor="{StaticResource AccentGreen}"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"/>
                            </VerticalStackLayout>

                            <!-- ОТКЛОНЕНО -->
                            <VerticalStackLayout 
                                    IsVisible="{Binding ShowRejectedIcon}"
                                    HorizontalOptions="Center"
                                    Spacing="8"
                                    Margin="0,12">
                                <Label 
                                    Text="Отклонено" 
                                    TextColor="{StaticResource AccentRed}"
                                    FontAttributes="Bold"
                                    FontSize="18"
                                    HorizontalOptions="Center"/>
                                <Label 
                                    Text="{Binding RetryButtonText}" 
                                    TextColor="{StaticResource TextSecondary}"
                                    FontSize="13"
                                    HorizontalOptions="Center"/>
                                </VerticalStackLayout>

                                <Button 
                                    Text="Повторить"
                                    Background="{StaticResource PurpleGradient}"
                                    TextColor="White"
                                    CornerRadius="12"
                                    HeightRequest="48"
                                    FontAttributes="Bold"
                                    Clicked="OnRetryClicked"
                                    CommandParameter="{Binding .}"
                                    IsVisible="{Binding ShowRetryButton}"/>

                                <Label 
                                    Text="{Binding StatusText}"
                                    TextColor="{Binding StatusColor}"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    HorizontalOptions="Center"
                                    IsVisible="{Binding ShowStatus}"/>

                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

        </RefreshView>

    </Grid>

    </ContentPage>